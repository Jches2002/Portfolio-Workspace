table aggregate
	lineageTag: 472810bc-f7d7-4247-ac0b-7df3e74de9d1

	measure 'Gross Profit Margin' = ```
			
			VAR Revenue =
			    CALCULATE(
			        SUM('Aggregate'[AmountConverted]),
			        glcodes[GlCodeGrouped] = "Revenue"
			    )
			VAR CostOfSales =
			    -CALCULATE(  //
			        SUM('Aggregate'[AmountConverted]),
			        glcodes[GlCodeGrouped] = "Cost of sales"
			    )
			VAR GrossProfit = Revenue - CostOfSales
			
			RETURN
			DIVIDE(GrossProfit, Revenue, 0)
			
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 69755913-104a-45ff-9d87-f10a484330ea

	measure 'Gross Profit' = ```
			
			VAR Revenue =
			    CALCULATE(
			        SUM('Aggregate'[AmountConverted]),
			        glcodes[GlCodeGrouped] = "Revenue"
			    )
			VAR CostOfSales =
			    -CALCULATE(            
			        SUM('Aggregate'[AmountConverted]),
			        glcodes[GlCodeGrouped] = "Cost of sales"
			    )
			RETURN
			Revenue - CostOfSales
			```
		formatString: "£"#,0.00;-"£"#,0.00;"£"#,0.00
		lineageTag: 09790070-82da-4248-8f14-d5432eee9c10

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	measure Overheads =
			CALCULATE(
			    SUM('aggregate'[AmountConverted]),
			    'glcodes'[ReportSection] = "Overheads"
			)
		formatString: "£"#,0.00;-"£"#,0.00;"£"#,0.00
		lineageTag: 8646710d-c210-4bae-9bfd-880e0316152a

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	measure 'Net Profit %' =
			
			VAR NetProfit = [Gross Profit] + [Overheads]
			RETURN
			DIVIDE(NetProfit, [Revenue])
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 82187566-edea-4603-a5c9-eef8e4fae99f

	measure 'Amount Change Status' =
			
			VAR CurrentAmount =
			    SUM('aggregate'[AmountConverted])
			
			VAR LastMonthAmount =
			    CALCULATE(
			        SUM('aggregate'[AmountConverted]),
			        PREVIOUSMONTH('period'[StartDate]),
			        ALLEXCEPT(
			            'aggregate',
			            'branch'[BranchHeader],
			            'department'[Name],
			            'glcodes'[GLCodeGrouped],
			            'glcodes'[Description],
			            'aggregate'[Activity]
			        )
			    )
			
			VAR Change =
			    CurrentAmount - LastMonthAmount
			
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(CurrentAmount) || ISBLANK(LastMonthAmount), BLANK(),
			        Change > 0, "Increase",
			        Change < 0, "Decrease",
			        "No Change"
			    )
		lineageTag: 7a9d10c5-f52c-4e7d-b646-4a548b8cd80a

	measure 'P&L Value' =
			
			SUM('aggregate'[AmountConverted])
		formatString: "£"#,0.00;-"£"#,0.00;"£"#,0.00
		lineageTag: e9e7d08e-cbf5-4bf7-bfd3-7a08a01d1472

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	measure 'Previous Month Value' =
			
			VAR CurrentPeriod =
			    SELECTEDVALUE(period[YearMonth])
			
			VAR PreviousPeriod =
			    MAXX(
			        FILTER(
			            ALL(period),
			            period[YearMonth] < CurrentPeriod
			        ),
			        period[YearMonth]
			    )
			
			RETURN
			    CALCULATE(
			        [P&L Value],
			        REMOVEFILTERS(period),
			        period[YearMonth] = PreviousPeriod
			    )
		formatString: 0
		lineageTag: c49cb269-5264-446a-8a82-57400336cbbb

	measure 'MoM Indicator' =
			
			VAR CurrentValue = [P&L Value]
			VAR PreviousValue = [Previous Month Value]
			
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(PreviousValue), BLANK(),
			        CurrentValue > PreviousValue, 1,
			        CurrentValue < PreviousValue, -1,
			        0
			    )
		formatString: 0
		lineageTag: 95160212-888a-4b9e-b3d7-23200842cae4

	measure Revenue = SUM('aggregate'[RevenueConverted])
		lineageTag: fa267a42-cb90-4d3b-ab6e-04a4288d67a9

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'ABS Overheads' = ABS([Overheads])
		formatString: "£"#,0.00;-"£"#,0.00;"£"#,0.00
		lineageTag: 3649c73d-c086-49c5-a93f-a193f2b363fa

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

