table budget
	lineageTag: b41e18c2-09ab-4cca-b70a-3dc30cb1bd85

	measure 'Revenue Budget' = CALCULATE(SUM(budget[BudgetAmount]),budget[PLCategory] = "Revenue")
		lineageTag: 86969473-f1e4-4d88-99d7-ee1e0b0772d8

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Revenue Variance £' = [Revenue] - [Revenue Budget]
		lineageTag: fc38ad9b-4958-4615-a398-1bbea316543e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Revenue Variance %' = DIVIDE([Revenue Variance £],[Revenue Budget])
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: ef66a025-5aca-4a22-8d90-24db8c7edf7b

	measure 'Gross profit budget' =
			
			VAR RevenueBudget = CALCULATE(SUM(budget[BudgetAmount]), budget[PLCategory] = "Revenue")
			VAR CostofSalesBudget = CALCULATE(SUM(budget[BudgetAmount]), budget[PLCategory] = "Cost of Sales")
			RETURN RevenueBudget + CostofSalesBudget
		lineageTag: a9db7d65-3e8e-49db-896f-3d5a48761c2f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Gross Profit Variance %' = DIVIDE([Gross Profit Variance],[Gross Profit Budget])
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: e88e1fbc-63c2-40e6-af25-6fe553777b3b

	measure 'Gross Profit Variance' = [Gross Profit] - [Gross Profit Budget]
		lineageTag: f2c05889-bc94-4a3b-8454-70653b8bff8f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Net Profit Budget' =
			
			VAR RevenueBudget = CALCULATE(SUM(budget[BudgetAmount]),budget[PLCategory] = "Revenue")
			VAR Costofsales = CALCULATE(SUM(budget[BudgetAmount]),budget[PLCategory] = "Cost of sales")
			VAR Overheads = CALCULATE(SUM(budget[BudgetAmount]),budget[PLCategory] = "Overheads")
			Return RevenueBudget + Costofsales + Overheads
		lineageTag: 3ac0d3c6-5234-4163-a43f-5370e01222e0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Net Variance' = ```
			[P&L Value]-[Net Profit Budget] 
			```
		lineageTag: 56ce1d04-beff-4b51-a053-6fc38406f53a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Net Profit Varinace %' = DIVIDE([Net Variance], [Net Profit Budget])
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 40671032-7720-4076-9019-f9b37e6bde95

	measure 'Overheads Budget' = CALCULATE(SUM(budget[BudgetAmount]),budget[PLCategory] = "Overheads")
		lineageTag: 3e81d338-73ec-4e31-90bd-97ed5bef1902

		annotation PBI_FormatHint = {"isGeneralNumber":true}

