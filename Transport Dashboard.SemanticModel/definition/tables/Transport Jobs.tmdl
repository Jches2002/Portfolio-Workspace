table 'Transport Jobs'
	lineageTag: 715b8f43-7372-474c-bc85-e4689f357e92

	measure 'Outsourced Jobs' = CALCULATE(COUNT('Transport Jobs'[Job ID]),'Transport Jobs'[Job Type] = "Outsourced")
		formatString: 0
		lineageTag: 6cecd226-766f-406d-ba33-5b8f41e26d36

	measure 'Outsourced %' =
			
			DIVIDE(
			    [Outsourced Jobs],
			    [Jobs]
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 29063fff-ba5e-438d-9627-549b05b35e27

	measure Jobs = COUNTROWS('Transport Jobs')
		formatString: 0
		lineageTag: ee235fbf-6f6a-4cbb-b72c-0efbf2148e71

	measure 'On time' = CALCULATE(COUNT('Transport Jobs'[Job ID]), 'Transport Jobs'[On-time Delivery] = "Yes")
		formatString: 0
		lineageTag: 69d1ee2a-be98-4f55-81d7-8e44149a4337

	measure 'Not on time' = CALCULATE(COUNT('Transport Jobs'[Job ID]), 'Transport Jobs'[On-time Delivery] = "No")
		formatString: 0
		lineageTag: 111a083e-96d4-4426-9cc5-6ace8be8024d

	measure 'On Time %' = DIVIDE([On time], [Jobs])
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 1029717e-eac8-465c-b6de-8667c6af2ad9

