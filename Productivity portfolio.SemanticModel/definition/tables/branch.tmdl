	column 'Portfolio Branch' =
			
			SWITCH(
			    [BranchName],
			
			    "Test Warehouse Branch", "Chelmsford Branch",
			    "Test North Branch", "Chelmsford Branch",
			
			    "Test Creative Branch", "Birmingham Branch",
			    "Test Central Services", "Birmingham Branch",
			    "Test Client Operations", "Birmingham Branch",
			    "Test Air Hub Branch", "Birmingham Branch",
			
			    "Test Central Branch", "Manchester Branch",
			    "Test International Branch", "Manchester Branch",
			    "Test Warehouse Branch 2", "Manchester Branch",
			    "Test Systems Branch", "Manchester Branch",
			
			    "Other"
			)
		lineageTag: d2bca1c6-3d04-4e0c-9fad-ee4a71f03e31
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

