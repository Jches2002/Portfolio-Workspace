table ActivityMerged
	lineageTag: 3338e189-e51f-4ef7-b174-0d0d6df99f84

	measure 'Capacity %' =
			
			DIVIDE(
			    SUM(ActivityMerged[Total Active]),
			SUM(ActivityMerged[Contract Mins ]),
			    0
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 3a7ba409-a91e-4b32-afe0-0c466acf95b7

	measure 'Total Active M' = [Total Active CW & 365] + [Training minutes]
		formatString: 0.00
		lineageTag: 504d3b20-288b-4df2-83f1-fe1300fadd7f

	measure 'Total Active CW & 365' = SUM(ActivityMerged[Total Active])
		formatString: 0.00
		lineageTag: cfad713e-e7f4-4e0b-8e6a-5a935411830e

	measure 'Training minutes' = [Training hours] * 60
		lineageTag: d9211364-a8d0-47a4-98e2-a81420538262

	measure 'Training hours' = [Training Days] * 7.5
		formatString: 0.00
		lineageTag: 1636539b-d76e-4cc9-b036-16e3f809ebc7

	measure 'Training Days' =
			
			CALCULATE(
			    SUM(EmployeeLeave[Duration _Days_]),
			    EmployeeLeave[Type] = "Training"
			)
		formatString: 0
		lineageTag: 46f7938a-03e9-406d-ac42-5477717b23c4

	measure 'Contracted Daily Hours' =
			
			DIVIDE(
			    MAX(PeopleHR_Staff[Contracted Hours]),
			    5
			)
		formatString: 0.00
		lineageTag: 1f40ca4a-45f5-4451-8880-10312146dd59

	measure 'Contracted hours M' = SUM(PeopleHR_Staff[Contracted Hours])
		formatString: 0.00
		lineageTag: 30a94475-547b-46d9-bf2d-847c6afbbb4e

	measure 'Contracted Minutes' = [Contracted Daily Hours] * 60
		formatString: 0.00
		lineageTag: 238c6b69-2319-4360-b354-086d4736ea35

	measure 'Total Contracted Minutes' =
			
			450 * ([Working Days Viva] - [Leave Duration])
		formatString: 0
		lineageTag: 3a23a01d-9cf1-4cd7-b4b4-0b95e70639d5

	measure 'Working Days Viva' =
			
			CALCULATE(
			    COUNTROWS(DatesViva),
			    DatesViva[Bank Holiday] = 0,
			    NOT (DatesViva[Day] IN {6, 7})
			)
		formatString: 0
		lineageTag: 28926b71-0f41-4f9c-8afc-33872843e2af

	measure 'Leave Duration' =
			
			CALCULATE(
			    SUM(EmployeeLeave[Duration _Days_]),
			    EmployeeLeave[Type] <> "Training"
			)
		formatString: 0
		lineageTag: a9ed034e-12ba-4558-996f-103f79635adf

	measure 'Average Total Active (hh:mm)' =
			
			VAR HoursValue = [Avg Active Hours per Person-Day]
			RETURN
			FORMAT(HoursValue / 24, "hh:mm")
		lineageTag: 004287a2-6326-4177-8bfe-90db63f82130

	measure 'Avg Active Hours per Person-Day' =
			
			VAR PersonDays =
			    SUMX(
			        VALUES('PeopleHR_Staff'[FullName]),
			        VAR AvailDays = [Working Days Viva] - [Leave Duration]
			        RETURN AvailDays
			    )
			RETURN
			DIVIDE( [Total Active M], PersonDays ) / 60
		lineageTag: b5329cf2-3c74-4abe-b83b-5413217adc7c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Active CW (d hh:mm)' = VAR HoursValue = SUM(ActivityMerged[TotalActiveTimeMinutesCW]) VAR Days = INT(HoursValue / 24) VAR RemainingHours = HoursValue - (Days * 24) VAR Hours = INT(RemainingHours) VAR Minutes = (RemainingHours - Hours) * 60 RETURN Days & "d " & FORMAT(Hours, "00") & ":" & FORMAT(Minutes, "00")
		lineageTag: d341009e-5ae0-4c71-b35d-44179a182e04

	measure 'Total Active CW Hours' = DIVIDE([Total Cargowise Active],60)
		lineageTag: 51b70507-bc53-4431-b9f3-f6d72f951dff

	measure 'Total Cargowise Active' = SUM(ActivityMerged[TotalActiveTimeMinutesCW])
		lineageTag: 2dd5e75f-3f75-4ad5-b5cb-a2a6817cf2a4

		annotation PBI_FormatHint = {"isGeneralNumber":true}

