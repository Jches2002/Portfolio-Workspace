	measure 'Capacity Colour' =
			
			SWITCH(
			    TRUE(),
			    [Capacity %] < 0.5, "#DC2626",
			    [Capacity %] < 0.75, "#F59E0B",
			    "#16A34A"
			)
		lineageTag: 53a422e8-fd36-4068-b21a-bc7f8ae8a227

	measure 'Average Active' =
			
			AVERAGE('ActivityMerged'[Total Active])
		lineageTag: 246070e5-4104-4a2d-a327-e35ef436bdea

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Average Active HHMM' =
			
			VAR AvgMinutes = AVERAGE('ActivityMerged'[Total Active])
			VAR Hours = INT(AvgMinutes / 60)
			VAR Minutes = MOD(ROUND(AvgMinutes, 0), 60)
			RETURN
			    FORMAT(Hours, "00") & ":" & FORMAT(Minutes, "00")
		lineageTag: 801359e8-f311-4fa5-8407-77440a730d3f

	measure 'Average Active MS' =
			
			AVERAGE('ActivityMerged'[Active Minutes 365])
		lineageTag: 9e2f200b-89dc-41ae-9270-7755c4afe73c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Average Active MS HHMM' =
			
			VAR AvgMinutes = AVERAGE('ActivityMerged'[Active Minutes 365])
			VAR Hours = INT(AvgMinutes / 60)
			VAR Minutes = MOD(ROUND(AvgMinutes, 0), 60)
			RETURN
			    FORMAT(Hours, "00") & ":" & FORMAT(Minutes, "00")
		lineageTag: 7bd5cc08-0ded-4712-8b36-144a408915a9

	measure 'Average Active APP HHMM' =
			
			VAR AvgMinutes = AVERAGE('ActivityMerged'[TotalActiveTimeMinutesCW])
			VAR Hours = INT(AvgMinutes / 60)
