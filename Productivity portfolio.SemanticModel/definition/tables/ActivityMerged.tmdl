		lineageTag: d4349adc-5197-4521-84a7-ca371d8eac54

	measure 'Avg Active Hours per Person-Day CW' =
			
			VAR PersonDays =
			    SUMX(
			        VALUES('PeopleHR_Staff'[FullName]),
			        VAR AvailDays = [Working Days Viva] - [Leave Duration]
			        RETURN AvailDays
			    )
			RETURN
			DIVIDE( [Total Cargowise Active], PersonDays ) / 60
		lineageTag: caf1eaac-d355-4ede-8602-164867be3bb1

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total 365 Active (d hh:mm)' = ```
			
			VAR HoursValue = [Total Active 365 Hours]
			
			VAR Days = INT(HoursValue / 24)
			VAR RemainingHours = HoursValue - (Days * 24)
			
			VAR Hours = INT(RemainingHours)
			VAR Minutes = (RemainingHours - Hours) * 60
			
			RETURN
			Days & "d " &
			FORMAT(Hours, "00") & ":" &
			FORMAT(Minutes, "00")
			
			```
		lineageTag: 37a6dbba-d63e-4e95-af2b-feb4f8302aae

	measure 'Total Active 365 Hours' = DIVIDE([Total 365 Active],60)
		lineageTag: 4765c038-f70f-44db-a6d5-b7f0eba10397

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Chat time (d hh:mm)' = ```
			
			VAR HoursValue = [Chat hours]
			
			VAR Days = INT(HoursValue / 24)
			VAR RemainingHours = HoursValue - (Days * 24)
			
			VAR Hours = INT(RemainingHours)
			VAR Minutes = (RemainingHours - Hours) * 60
			
			RETURN
			Days & "d " &
			FORMAT(Hours, "00") & ":" &
			FORMAT(Minutes, "00")
			
			```
		lineageTag: 15f1a04c-9475-42d9-bbce-6935f91cdfa7

	measure 'Chat hours' = DIVIDE([Chat minutes m], 60)
