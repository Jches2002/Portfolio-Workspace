table PeopleHR_Staff
	lineageTag: b16e924f-91b9-49ee-9c00-eb19040b6dec

	measure 'Contracted Hours Check' =
			
			MAX(PeopleHR_Staff[Contracted Hours])
		lineageTag: 44fe2aae-d6a7-4585-8d10-8f3fd2ca3b35

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avaliable working days' = PeopleHR_Staff[People Count Active] * [Working Days Future]
		lineageTag: 45fdd4ce-e150-4edc-808e-078d223811e6

	measure 'People Count Active' =
			
			VAR SelectedDate = MAX('FutureDates'[Date])
			RETURN
			CALCULATE(
			    COUNT(PeopleHR_Staff[Employee Id]),
			    FILTER(
			        PeopleHR_Staff,
			        PeopleHR_Staff[Start Date] <= SelectedDate &&
			        (
			            ISBLANK(PeopleHR_Staff[Final Day Employment]) ||
			            PeopleHR_Staff[Final Day Employment] >= SelectedDate
			        )
			    )
			)
		formatString: 0
		lineageTag: ce21e223-25be-468b-bd41-5597bebae38f

	measure 'Working Days Future' = ```
			
			CALCULATE(
			    COUNTROWS(FutureDates),
			    FutureDates[Bank Holiday] = 0,
			    NOT (FutureDates[Day] IN {6, 7})
			)
			
			```
		formatString: 0
		lineageTag: 34377d52-9f7f-4268-911a-90f317b83c5e

