table EmployeeLeave
	lineageTag: 5dfff5fd-f3f2-47f2-b39f-dada53d0de67

	measure 'Absence %' =
			
			DIVIDE(
			    SUM(EmployeeLeave[Duration _Days_]),
			    [Avaliable working days],
			    0
			)
		formatString: 0.00%;-0.00%;0.00%
