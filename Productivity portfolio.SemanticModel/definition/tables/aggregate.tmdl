table aggregate
	lineageTag: 1ba46d47-84e4-4504-a64c-35472d2ff0c8

	measure 'Unutilised Cost Dynamic' =
			
			VAR EmployeeSelected =
			    HASONEVALUE(EmployeesOffice[EmployeeId])
			
			VAR DepartmentOverheads =
			    CALCULATE(
			        [Salaries],
			        REMOVEFILTERS(EmployeesOffice[EmployeeId]),
			        REMOVEFILTERS(EmployeesOffice[Name])
			    )
			
			VAR DepartmentCapacity =
			    CALCULATE(
			        [Capacity %],
			        REMOVEFILTERS(EmployeesOffice[EmployeeId]),
			        REMOVEFILTERS(EmployeesOffice[Name])
			    )
			
			VAR DepartmentUnutilisedCost =
			    DepartmentOverheads *
			    MAX(
			        0,
			        1 - DepartmentCapacity
			    )
			
			VAR EmployeesInDepartment =
			    CALCULATE(
			        DISTINCTCOUNT(EmployeesOffice[EmployeeId]),
			        REMOVEFILTERS(EmployeesOffice[EmployeeId]),
			        REMOVEFILTERS(EmployeesOffice[Name])
			    )
			
			VAR CostAllocatedToEmployee =
			    DIVIDE(
			        DepartmentUnutilisedCost,
			        EmployeesInDepartment
			    )
			
			VAR EmployeeUnutilisedPercentage =
			    MAX(
			        0,
			        1 - [Capacity %]
			    )
			
			VAR EmployeeUnutilisedCost =
			    CostAllocatedToEmployee
			        * EmployeeUnutilisedPercentage
			
			RETURN
			    IF(
			        EmployeeSelected,
			        EmployeeUnutilisedCost,
			        DepartmentUnutilisedCost
			    )
		formatString: "£"#,0.00;-"£"#,0.00;"£"#,0.00
		lineageTag: 5487b7d3-7ce4-4378-99fd-2a7e84d2334e

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	measure Salaries = CALCULATE(SUM('aggregate'[PeriodAmount]),glcodes[ReportSection] = "Overheads", glcodes[GlCodeGrouped] = "Salaries")
		formatString: "£"#,0.00;-"£"#,0.00;"£"#,0.00
		lineageTag: 0b53db95-1377-48f5-8dfa-d09f0701f733

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

